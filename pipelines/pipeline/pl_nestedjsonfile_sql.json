{
	"name": "pl_nestedjsonfile_sql",
	"properties": {
		"activities": [
			{
				"name": "nestedjson_copy",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['employeeId']"
								},
								"sink": {
									"name": "employeeId",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['name']['first']"
								}
							},
							{
								"source": {
									"path": "$['name']['last']"
								}
							},
							{
								"source": {
									"path": "$['contact']['email']"
