							},
							{
								"source": {
									"path": "$['projects'][0]['projectId']"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['name']"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['role']"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['technologies'][0]"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['tasks'][0]['taskId']"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['tasks'][0]['description']"
								}
							},
							{
								"source": {
									"path": "$['projects'][0]['tasks'][0]['status']"
								}
							},
							{
								"source": {
									"path": "$['audit']['createdOn']"
								},
								"sink": {
									"name": "createdOn",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['audit']['modifiedOn']"
								},
								"sink": {
									"name": "modifiedOn",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['audit']['createdBy']"
								},
								"sink": {
									"name": "createdBy",
									"type": "String"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "src_ds_nestedfile",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "snk_ds_nestedtable",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-11-24T11:13:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
