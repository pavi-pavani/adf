								"sink": {
									"name": "email",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['contact']['phones'][0]['type']"
								}
							},
							{
								"source": {
									"path": "$['contact']['phones'][0]['number']"
								}
							},
							{
								"source": {
									"path": "$['contact']['address']['line1']"
								}
							},
							{
								"source": {
									"path": "$['contact']['address']['line2']"
								}
							},
							{
								"source": {
									"path": "$['contact']['address']['city']"
								},
								"sink": {
									"name": "city",
									"type": "String"
